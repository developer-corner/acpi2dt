Grammatik

    0 $accept: AslCode $end

    1 AslCode: DefinitionBlockList
    2        | error

    3 @1: /* leer */

    4 $@2: /* leer */

    5 DefinitionBlockTerm: PARSEOP_DEFINITION_BLOCK PARSEOP_OPEN_PAREN @1 String ',' String ',' ByteConst ',' String ',' String ',' DWordConst PARSEOP_CLOSE_PAREN $@2 '{' TermList '}'

    6 DefinitionBlockList: DefinitionBlockTerm
    7                    | DefinitionBlockTerm DefinitionBlockList

    8 NameString: NameSeg
    9           | PARSEOP_NAMESTRING
   10           | PARSEOP_IO
   11           | PARSEOP_DMA
   12           | PARSEOP_IRQ
   13           | PARSEOP_FOR

   14 NameSeg: PARSEOP_NAMESEG

   15 Term: Object
   16     | Type1Opcode
   17     | Type2Opcode
   18     | Type2IntegerOpcode
   19     | Type2StringOpcode
   20     | Type2BufferOpcode
   21     | Type2BufferOrStringOpcode
   22     | error

   23 SuperName: SimpleName
   24          | DebugTerm
   25          | Type6Opcode

   26 Target: /* leer */
   27       | ','
   28       | ',' SuperName

   29 TermArg: SimpleName
   30        | Type2Opcode
   31        | DataObject
   32        | PARSEOP_OPEN_PAREN TermArg PARSEOP_CLOSE_PAREN

   33 $@3: /* leer */

   34 MethodInvocationTerm: NameString PARSEOP_OPEN_PAREN $@3 ArgList PARSEOP_CLOSE_PAREN

   35 OptionalCount: /* leer */
   36              | ','
   37              | ',' TermArg

   38 OptionalDataCount: /* leer */
   39                  | PARSEOP_OPEN_PAREN TermArg PARSEOP_CLOSE_PAREN
   40                  | PARSEOP_OPEN_PAREN PARSEOP_CLOSE_PAREN
   41                  | PARSEOP_EXP_EQUALS
   42                  | PARSEOP_OPEN_PAREN TermArg PARSEOP_CLOSE_PAREN PARSEOP_EXP_EQUALS
   43                  | PARSEOP_OPEN_PAREN PARSEOP_CLOSE_PAREN String PARSEOP_EXP_EQUALS

   44 TermList: /* leer */
   45         | TermList Term
   46         | TermList Term ';'
   47         | TermList ';' Term
   48         | TermList ';' Term ';'

   49 ArgList: /* leer */
   50        | TermArg
   51        | ArgList ','
   52        | ArgList ',' TermArg

   53 ByteList: /* leer */
   54         | ByteConstExpr
   55         | ByteList ','
   56         | ByteList ',' ByteConstExpr

   57 DWordList: /* leer */
   58          | DWordConstExpr
   59          | DWordList ','
   60          | DWordList ',' DWordConstExpr

   61 FieldUnitList: /* leer */
   62              | FieldUnit
   63              | FieldUnitList ','
   64              | FieldUnitList ',' FieldUnit

   65 FieldUnit: FieldUnitEntry
   66          | OffsetTerm
   67          | AccessAsTerm
   68          | ConnectionTerm

   69 FieldUnitEntry: ',' AmlPackageLengthTerm
   70               | NameSeg ',' AmlPackageLengthTerm

   71 Object: CompilerDirective
   72       | NamedObject
   73       | NameSpaceModifier

   74 PackageList: /* leer */
   75            | PackageElement
   76            | PackageList ','
   77            | PackageList ',' PackageElement

   78 PackageElement: DataObject
   79               | NameString

   80 ParameterTypePackage: /* leer */
   81                     | ObjectTypeKeyword
   82                     | ParameterTypePackage ',' ObjectTypeKeyword

   83 ParameterTypePackageList: /* leer */
   84                         | ObjectTypeKeyword
   85                         | '{' ParameterTypePackage '}'

   86 OptionalParameterTypePackage: /* leer */
   87                             | ',' ParameterTypePackageList

   88 ParameterTypesPackage: ParameterTypePackageList
   89                      | ParameterTypesPackage ',' ParameterTypePackageList

   90 ParameterTypesPackageList: /* leer */
   91                          | ObjectTypeKeyword
   92                          | '{' ParameterTypesPackage '}'

   93 OptionalParameterTypesPackage: /* leer */
   94                              | ',' ParameterTypesPackageList

   95 CaseDefaultTermList: /* leer */
   96                    | CaseTerm
   97                    | DefaultTerm
   98                    | CaseDefaultTermList CaseTerm
   99                    | CaseDefaultTermList DefaultTerm

  100 DataObject: BufferData
  101           | PackageData
  102           | IntegerData
  103           | StringData

  104 BufferData: Type5Opcode
